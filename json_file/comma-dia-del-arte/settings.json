{
    "workbench.colorCustomizations": {
        "activityBar.background": "#a72413",  // Couleur de fond de la barre latérale
        "activityBar.foreground": "#e4c88b",  // Couleur du texte et des icônes
        "activityBar.inactiveForeground": "#f0a465a1",  // Couleur du texte et des icônes inactives
        "activityBarBadge.background": "#6c9c8c",  // Couleur de fond de l'insigne de la barre latérale
        "activityBarBadge.foreground": "#264238",  // Couleur du texte de l'insigne de la barre latérale

        "statusBar.background": "#691c12",  // Couleur de fond de la barre d'état
        "statusBar.foreground": "#13030fb2",  // Couleur du texte de la barre d'état
        "statusBar.noFolderBackground": "#333333",  // Couleur de fond de la barre d'état sans dossier ouvert
