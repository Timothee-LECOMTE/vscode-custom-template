        "titleBar.inactiveForeground": "#CCCCCC",  // Couleur du texte de la barre de titre lorsqu'elle est inactive

        "statusBarItem.remoteBackground": "#264238",
        "statusBarItem.remoteForeground": "#6c9c8c",
