{
    "workbench.colorCustomizations": {
        "activityBar.background": "#706986",  // Couleur de fond de la barre latérale
        "activityBar.foreground": "#303030",  // Couleur du texte et des icônes
        "activityBar.inactiveForeground": "#443e55",  // Couleur du texte et des icônes inactives
        "activityBarBadge.background": "#d3bb79",  // Couleur de fond de l'insigne de la barre latérale
        "activityBarBadge.foreground": "#f1f0ec",  // Couleur du texte de l'insigne de la barre latérale

        "statusBar.background": "#313131",  // Couleur de fond de la barre d'état
        "statusBar.foreground": "#cfcadda4",  // Couleur du texte de la barre d'état
