{
    "workbench.colorCustomizations": {
        "activityBar.background": "#d13737",  // Couleur de fond de la barre latérale
        "activityBar.foreground": "#f1edee",  // Couleur du texte et des icônes
        "activityBar.inactiveForeground": "#e07b84",  // Couleur du texte et des icônes inactives
        "activityBarBadge.background": "#1a662a",  // Couleur de fond de l'insigne de la barre latérale
        "activityBarBadge.foreground": "#e6ece8",  // Couleur du texte de l'insigne de la barre latérale

        "statusBar.background": "#8d3139",  // Couleur de fond de la barre d'état
        "statusBar.foreground": "#e7c4c7",  // Couleur du texte de la barre d'état
        "statusBar.noFolderBackground": "#333333",  // Couleur de fond de la barre d'état sans dossier ouvert
        "statusBar.debuggingBackground": "#8d3139",  // Couleur de fond de la barre d'état en mode débogage
        "statusBar.debuggingForeground": "#e7c4c7",  // Couleur du texte de la barre d'état en mode débogage

        "titleBar.activeBackground": "#333333",  // Couleur de fond de la barre de titre lorsqu'elle est active
        "titleBar.activeForeground": "#FFFFFF",  // Couleur du texte de la barre de titre lorsqu'elle est active
        "titleBar.inactiveBackground": "#1E1E1E",  // Couleur de fond de la barre de titre lorsqu'elle est inactive
        "titleBar.inactiveForeground": "#CCCCCC",  // Couleur du texte de la barre de titre lorsqu'elle est inactive

        "statusBarItem.remoteBackground": "#1a662a",
        "statusBarItem.remoteForeground": "#eae8f5",
