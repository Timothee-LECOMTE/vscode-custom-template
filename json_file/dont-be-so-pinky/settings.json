// dont-be-so-pinky
{
    "workbench.colorCustomizations": {
        "activityBar.background": "#ca6c90",  // Couleur de fond de la barre latérale
        "activityBar.foreground": "#ffbaba",  // Couleur du texte et des icônes
        "activityBar.inactiveForeground": "#2e1821",  // Couleur du texte et des icônes inactives
        "activityBarBadge.background": "#ffa65d",  // Couleur de fond de l'insigne de la barre latérale
        "activityBarBadge.foreground": "#310f0c",  // Couleur du texte de l'insigne de la barre latérale

        "statusBar.background": "#b34566",  // Couleur de fond de la barre d'état
        "statusBar.foreground": "#e0d6c8",  // Couleur du texte de la barre d'état
        "statusBar.noFolderBackground": "#b34566",  // Couleur de fond de la barre d'état sans dossier ouvert
        "statusBar.debuggingBackground": "#b34566",  // Couleur de fond de la barre d'état en mode débogage
        "statusBar.debuggingForeground": "#e0d6c8",  // Couleur du texte de la barre d'état en mode débogage

        "titleBar.activeBackground": "#432a34",  // Couleur de fond de la barre de titre lorsqu'elle est active
        "titleBar.activeForeground": "#e0d6c8",  // Couleur du texte de la barre de titre lorsqu'elle est active
        "titleBar.inactiveBackground": "#30252b",  // Couleur de fond de la barre de titre lorsqu'elle est inactive
        "titleBar.inactiveForeground": "#e8e5df",  // Couleur du texte de la barre de titre lorsqu'elle est inactive

        "editorCursor.foreground": "#ffbaba",
        "editor.lineHighlightBackground": "#ffbaba20",
        "focusBorder": "#ffbaba",
        "sideBar.background": "#382c33",
        "sideBar.foreground": "#e0d6c8",
        "statusBarItem.remoteBackground": "#532333",
        "statusBarItem.remoteForeground": "#caa7b4",
