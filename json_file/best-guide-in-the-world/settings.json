{
    "workbench.colorCustomizations": {
        "activityBar.background": "#f0ebeb",  // Couleur de fond de la barre latérale
        "activityBar.foreground": "#dd6771",  // Couleur du texte et des icônes
        "activityBar.inactiveForeground": "#3a337e",  // Couleur du texte et des icônes inactives
        "activityBarBadge.background": "#daae85",  // Couleur de fond de l'insigne de la barre latérale
        "activityBarBadge.foreground": "#f3f2f1",  // Couleur du texte de l'insigne de la barre latérale

        "statusBar.background": "#e29299",  // Couleur de fond de la barre d'état
        "statusBar.foreground": "#961f33",  // Couleur du texte de la barre d'état
        "statusBar.noFolderBackground": "#e29299",  // Couleur de fond de la barre d'état sans dossier ouvert
        "statusBar.debuggingBackground": "#e29299",  // Couleur de fond de la barre d'état en mode débogage
        "statusBar.debuggingForeground": "#961f33",  // Couleur du texte de la barre d'état en mode débogage

        "titleBar.activeBackground": "#efdad9",  // Couleur de fond de la barre de titre lorsqu'elle est active
        "titleBar.activeForeground": "#961f33",  // Couleur du texte de la barre de titre lorsqu'elle est active
        "titleBar.inactiveBackground": "#f1e7e4",  // Couleur de fond de la barre de titre lorsqu'elle est inactive
        "titleBar.inactiveForeground": "#343434",  // Couleur du texte de la barre de titre lorsqu'elle est inactive

        "editorCursor.foreground": "#dd6771",
        "editor.lineHighlightBackground": "#dd677120",
        "focusBorder": "#dd6771",
        "sideBar.background": "#f3f0ed",
        "sideBar.foreground": "#961f33",
        "statusBarItem.remoteBackground": "#383366",
        "statusBarItem.remoteForeground": "#eae8f5",
